{
  "name": "facet",
  "version": "1.0.0",
  "description": "FaceT — Markdown workbench that treats the AST as a first-class citizen: source / render / AST panes in sync, offline-first, zero runtime dependencies.",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "author": "bo天天开心 (BO0401)",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/BO0401/facet.git"
  },
  "bugs": {
    "url": "https://github.com/BO0401/facet/issues"
  },
  "homepage": "https://github.com/BO0401/facet#readme",
  "keywords": [
    "markdown",
    "markdown-editor",
    "ast",
    "commonmark",
    "wysiwyg",
    "electron",
    "offline-first",
    "notes"
  ],
  "scripts": {
    "test": "npm run test:spec && npm run test:unit && npm run test:smoke",
    "test:spec": "node test/run-spec.js",
    "test:unit": "node test/unit/unit.test.js",
    "test:smoke": "npm run build && node test/unit/bundle-smoke.js",
    "test:electron": "node test/e2e/e2e-electron.cjs",
    "build": "node build/bundle.js",
    "start": "electron .",
    "dist:dir": "npm run build && node build/make-app.js",
    "dist": "npm run build && node build/make-exe.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=18"
  }
}
