{
  "name": "facet",
  "version": "1.0.0",
  "description": "Facet · 切面 — 一份源码，多个切面。把 Markdown 的 AST 中间层做成一等公民的桌面工作台。",
  "type": "module",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "npm run test:spec && npm run test:unit && npm run test:smoke",
    "test:spec": "node test/run-spec.js",
    "test:unit": "node test/unit/unit.test.js",
    "test:smoke": "npm run build && node test/unit/bundle-smoke.js",
    "test:electron": "node test/e2e/e2e-electron.cjs",
    "build": "node build/bundle.js",
    "start": "electron .",
    "dist:dir": "npm run build && node build/make-app.js",
    "dist": "npm run build && node build/make-exe.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=18"
  }
}
